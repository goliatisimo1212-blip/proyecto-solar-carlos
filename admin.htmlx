<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Administración - Leads Solares</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen p-8">

    <div class="max-w-6xl mx-auto space-y-6">
        <div class="flex justify-between items-center bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-xl">
            <div>
                <span class="bg-amber-500/10 text-amber-400 text-xs font-semibold px-3 py-1 rounded-full border border-amber-500/20">Panel v2.4.0</span>
                <h1 class="text-2xl font-bold text-white mt-1">Empresas Captadas (Ley 1715)</h1>
            </div>
            <a href="index.html" class="bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg text-sm transition-colors border border-slate-700">
                Ir a la Calculadora
            </a>
        </div>

        <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center">
                <h2 class="text-sm font-semibold text-slate-300">Base de Datos de Prospectos</h2>
                <button onclick="cargarLeads()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-3 py-1.5 rounded-lg text-xs transition-all">
                    Actualizar Lista
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950 text-xs uppercase text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="p-4">ID</th>
                            <th class="p-4">Empresa</th>
                            <th class="p-4">Correo</th>
                            <th class="p-4">Factura Mensual</th>
                            <th class="p-4">Calificación CAPEX</th>
                            <th class="p-4">Acción Comercial</th>
                        </tr>
                    </thead>
                    <tbody id="tablaLeads" class="divide-y divide-slate-800">
                        <!-- Carga dinámica -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        async function cargarLeads() {
            try {
                const response = await fetch('/api/v1/leads');
                const leads = await response.json();
                const tbody = document.getElementById('tablaLeads');
                tbody.innerHTML = '';

                if (leads.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-500">No hay leads registrados todavía.</td></tr>`;
                    return;
                }

                leads.forEach(lead => {
                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-slate-800/50 transition-colors";
                    tr.innerHTML = `
                        <td class="p-4 font-mono text-slate-400">#${lead.id}</td>
                        <td class="p-4 font-semibold text-white">${lead.empresa}</td>
                        <td class="p-4 text-slate-400">${lead.contacto_email}</td>
                        <td class="p-4 text-emerald-400 font-mono">$${lead.pago_mensual_cop.toLocaleString('es-CO')} COP</td>
                        <td class="p-4">
                            <span class="bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-1 rounded-full border border-emerald-500/20">
                                ${lead.es_apto_capex}
                            </span>
                        </td>
                        <td class="p-4">
                            <a href="/api/v1/leads/${lead.id}/pdf" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs transition-all inline-block">
                                Ver Propuesta PDF
                            </a>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error('Error al cargar leads:', err);
            }
        }
        cargarLeads();
    </script>
</body>
</html>
